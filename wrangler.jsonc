{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axiom-research",
  "main": "build/cloudflare-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "axiom-db",
      "database_id": "d61aa039-8095-4085-b972-2faf1010b0e1",
      "migrations_dir": "drizzle"
    }
  ],
  "assets": {
    "run_worker_first": true,
    "binding": "ASSETS"
  }
}
